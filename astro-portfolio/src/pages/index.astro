---
import BaseLayout from '../layouts/BaseLayout.astro';
import WallPiece from '../components/WallPiece.astro';
import AnsiTitle from '../components/AnsiTitle.astro';
import AnsiDivider from '../components/AnsiDivider.astro';
import AnsiDrips from '../components/AnsiDrips.astro';
import { featuredProjects } from '../data/projects';
---

---
<BaseLayout
    kind="home"
    title="Stephen Lyons — Cybersecurity Engineer"
    description="Stephen Lyons — Cybersecurity Engineer. Portfolio showcasing DevSecOps, cloud security, and threat detection expertise."
>
    <!-- Hero Section -->
    <section class="hero" aria-label="Introduction">
        <WallPiece
            text="PWN3D"
            spot="side-right"
            style="bubble"
            seed={1}
            h="9rem"
            tilt={-4}
            top="74%"
        />
        <div class="container">
            <div class="hero-content">
                <!-- The name and the subheader are two pieces with their own entrance and their own
                     grab-and-fling (fx.ts, mouse only; touch keeps scrolling the page). Each entrance
                     sits on an outer wrapper, so it never fights the drag's transform. -->
                <div class="hero-name reveal">
                    <div class="drag-art" data-drag="fine">
                        <AnsiTitle text="Stephen Lyons" as="h1" maxFont={12} class="hero-piece" />
                    </div>
                </div>
                <div class="hero-tagline reveal">
                    <div class="drag-art" data-drag="fine">
                        <AnsiTitle
                            text="Cyber Security Engineer"
                            as="p"
                            seed={4}
                            maxFont={7}
                            minFont={3}
                            lines={2}
                            opts={{ drips: 0.12, dripMax: 6, overspray: 0 }}
                            wildOpts={{ blades: 0.25, sparkles: 1, dripMax: 6, overspray: 0 }}
                            class="hero-sub"
                        />
                    </div>
                </div>
                <div class="hero-cta reveal">
                    <a href="/projects" class="btn btn--filled">
                        View Projects →
                    </a>
                    <a href="/about" class="btn">
                        About Me
                    </a>
                    <a href="/contact" class="btn">
                        Get In Touch
                    </a>
                </div>
                <div
                    class="hero-terminal reveal"
                    role="img"
                    aria-label="Animated terminal introduction"
                >
                    <div class="hero-terminal__bar">
                        <span class="hero-terminal__dot hero-terminal__dot--red"></span>
                        <span class="hero-terminal__dot hero-terminal__dot--yellow"></span>
                        <span class="hero-terminal__dot hero-terminal__dot--green"></span>
                        <span class="hero-terminal__title">stephen@lyons:~</span>
                    </div>
                    <div
                        class="hero-terminal__body"
                        id="hero-typed"
                        tabindex="0"
                        role="group"
                        aria-label="Terminal output"
                    ></div>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Projects -->
    <section class="section" aria-label="Featured projects">
        <WallPiece
            text="H4CK"
            spot="gap-right"
            style="wild"
            seed={2}
            h="4.5rem"
            hMobile="3rem"
            tilt={3}
            inside
        />
        <WallPiece
            text="CV3"
            spot="gutter-left"
            style="wild"
            seed={6}
            h="7rem"
            tilt={-5}
            top="45%"
        />
        <div class="container">
            <div class="reveal">
                <span class="section-label">Featured Work</span>
                <h2 class="section-title">Recent Projects</h2>
            </div>

            <div class="featured-grid">
                {featuredProjects.map((p, i) => (
                    <a href={`/projects#${p.id}`} class="card-link">
                        <article class="card reveal">
                            <span class="card__tag">{p.featuredTag ?? p.tag}</span>
                            <h3 class="card__title glitch">{p.featuredTitle ?? p.title}</h3>
                            <p class="card__desc">{p.featuredDesc ?? p.descriptions[0]}</p>
                            <div class="card__tech">
                                {(p.featuredTech ?? p.tech).map((t) => (
                                    <span>{t}</span>
                                ))}
                            </div>
                            <AnsiDrips
                                cols={110}
                                seed={i + 11}
                                maxStem={4}
                                minStem={1}
                                density={0.1}
                                class="card-drips"
                            />
                        </article>
                    </a>
                ))}
            </div>
        </div>
    </section>

    <!-- Capabilities Overview -->
    <section class="section" aria-label="Capabilities">
        <WallPiece text="r00t" spot="gap-left" style="wild" seed={3} h="5.5rem" tilt={-3} />
        <WallPiece
            text="SUD0"
            spot="gutter-right"
            style="bubble"
            seed={7}
            h="6.5rem"
            tilt={4}
            top="35%"
        />
        <WallPiece
            text="PWN"
            spot="gutter-left"
            style="wild"
            seed={10}
            h="6.5rem"
            tilt={-4}
            top="78%"
        />
        <div class="container">
            <div class="reveal">
                <span class="section-label">What I Do</span>
                <h2 class="section-title">Core Capabilities</h2>
            </div>

            <div class="grid-3">
                <div class="card reveal">
                    <h3 class="card__title">DevSecOps &amp; CI/CD</h3>
                    <p class="card__desc">
                        Building and maintaining CI/CD pipelines in GitHub Actions with embedded
                        security checks, compliance gates, and automated deployments across AWS and
                        Azure.
                    </p>
                    <AnsiDrips
                        cols={110}
                        seed={21}
                        maxStem={4}
                        minStem={1}
                        density={0.1}
                        class="card-drips"
                    />
                </div>
                <div class="card reveal">
                    <h3 class="card__title">Cloud Security Architecture</h3>
                    <p class="card__desc">
                        Designing secure SaaS architectures, automating policy enforcement,
                        infrastructure hardening, and continuous monitoring across multi-cloud
                        environments.
                    </p>
                    <AnsiDrips
                        cols={110}
                        seed={22}
                        maxStem={4}
                        minStem={1}
                        density={0.1}
                        class="card-drips"
                    />
                </div>
                <div class="card reveal">
                    <h3 class="card__title">Threat Detection &amp; SIEM</h3>
                    <p class="card__desc">
                        Developing SIEM platforms for real-time visibility and incident response.
                        Automating log collection, normalization, and enrichment from cloud,
                        endpoint, and SaaS sources.
                    </p>
                    <AnsiDrips
                        cols={110}
                        seed={23}
                        maxStem={4}
                        minStem={1}
                        density={0.1}
                        class="card-drips"
                    />
                </div>
                <div class="card reveal">
                    <h3 class="card__title">Endpoint Security &amp; DLP</h3>
                    <p class="card__desc">
                        Deploying EDR solutions for comprehensive device protection and implementing
                        DLP controls to safeguard sensitive data across the enterprise.
                    </p>
                    <AnsiDrips
                        cols={110}
                        seed={24}
                        maxStem={4}
                        minStem={1}
                        density={0.1}
                        class="card-drips"
                    />
                </div>
                <div class="card reveal">
                    <h3 class="card__title">Incident Response</h3>
                    <p class="card__desc">
                        Leading security operations including triage, investigation, containment,
                        and remediation. Maintaining and improving automated playbooks and
                        escalation workflows.
                    </p>
                    <AnsiDrips
                        cols={110}
                        seed={25}
                        maxStem={4}
                        minStem={1}
                        density={0.1}
                        class="card-drips"
                    />
                </div>
                <div class="card reveal">
                    <h3 class="card__title">Infrastructure as Code</h3>
                    <p class="card__desc">
                        Developing and managing infrastructure with Terraform and Ansible to
                        standardize configurations, enforce compliance, and ensure consistent,
                        secure deployments.
                    </p>
                    <AnsiDrips
                        cols={110}
                        seed={26}
                        maxStem={4}
                        minStem={1}
                        density={0.1}
                        class="card-drips"
                    />
                </div>
            </div>

            <AnsiDivider seed={6} />
            <div
                class="stats-row reveal"
                style="display: flex; justify-content: center; align-items: center; gap: 2rem; flex-wrap: wrap; text-align: center;"
            >
                <div class="stat">
                    <div class="stat__number">3+</div>
                    <div class="stat__label">Years in Cybersecurity</div>
                </div>
                <div class="stat">
                    <div class="stat__number">5+</div>
                    <div class="stat__label">Professional Roles</div>
                </div>
                <div class="stat">
                    <div class="stat__number">10+</div>
                    <div class="stat__label">Security Tools Managed</div>
                </div>
                <div class="stat">
                    <div class="stat__number">B.S.</div>
                    <div class="stat__label">Computer Science, CSULB</div>
                </div>
            </div>
            <style>
                .stats-row {
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    gap: 2rem;
                    flex-wrap: wrap;
                    text-align: center;
                }
                .stat {
                    min-width: 120px;
                }
                @media (max-width: 600px) {
                    .stats-row {
                        flex-direction: column;
                        gap: 1.25rem;
                    }
                    .stat {
                        min-width: 0;
                    }
                }
            </style>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="section" aria-label="Call to action">
        <WallPiece text="1337" spot="gap-right" style="wild" seed={4} h="5rem" tilt={4} />
        <WallPiece text="SL" spot="side-left" style="wild" seed={8} h="8rem" tilt={-6} top="58%" />
        <WallPiece
            text="0DAY"
            spot="side-right"
            style="bubble"
            seed={9}
            h="6.5rem"
            tilt={5}
            top="62%"
        />
        <div class="container" style="text-align:center;">
            <div class="reveal">
                <span class="section-label">Let's Connect</span>
                <h2 class="section-title">Interested in Working Together?</h2>
                <p style="color:var(--text-secondary);max-width:500px;margin:0 auto 2rem;font-size:0.95rem;">
                    I'm always open to discussing cybersecurity challenges, DevSecOps best
                    practices, or potential collaborations.
                </p>
                <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
                    <a href="/contact" class="btn btn--filled">
                        Contact Me →
                    </a>
                    <a href="/about" class="btn">
                        Learn More
                    </a>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
