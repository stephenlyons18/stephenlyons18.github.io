---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnsiTitle from '../components/AnsiTitle.astro';
import AnsiDivider from '../components/AnsiDivider.astro';
import SkillGraph from '../components/react/SkillGraph';
import { jobs } from '../data/experience';
---

<BaseLayout
    kind="about"
    title="About — Stephen Lyons"
    description="About Stephen Lyons — Cybersecurity Engineer specializing in DevSecOps, cloud security, and threat detection."
>
    <section class="page-header" aria-label="Page header">
        <div class="container reveal">
            <span class="section-label">About Me</span>
            <!-- Grab-and-fling with a mouse (fx.ts), like the home title; touch keeps scrolling. -->
            <div class="drag-art" data-drag="fine">
                <AnsiTitle text="About" label="About Stephen Lyons" as="h1" style="wild" seed={3} />
            </div>
            <p class="page-desc">
                Cybersecurity Engineer building secure, resilient systems at enterprise scale.
            </p>
            <AnsiDivider seed={2} />
        </div>
    </section>

    <section class="section" style="padding-top:0;" aria-label="Biography and details">
        <div class="container">
            <div class="about-grid">
                <aside class="about-sidebar reveal">
                    <div class="about-avatar" aria-hidden="true">
                        <div class="drag-art" data-drag>
                            <AnsiTitle text="SL" style="bubble" decorative maxFont={9} seed={5} />
                        </div>
                    </div>
                    <h2 class="about-name">Stephen Lyons</h2>
                    <p class="about-role">Cybersecurity Engineer</p>
                    <div class="about-meta">
                        <p>
                            <strong>Location:</strong> Southern California
                        </p>
                        <p>
                            <strong>Company:</strong> Yamaha Motor Corporation
                        </p>
                        <p>
                            <strong>Email:</strong> stephen.lyons18@gmail.com
                        </p>
                        <p>
                            <strong>Web:</strong>
                            <a href="https://stephenlyons.dev">stephenlyons.dev</a>
                        </p>
                    </div>
                </aside>

                <div>
                    <div class="reveal" style="margin-bottom: 3rem;">
                        <span class="section-label">Summary</span>
                        <h2 class="section-title" style="font-size:1.5rem;">
                            Professional Background
                        </h2>
                        <p style="color:var(--text-secondary);line-height:1.8;margin-bottom:1rem;">
                            I'm a Cybersecurity Engineer at Yamaha Motor Corporation with a strong
                            foundation in both offensive and defensive security practices. My work
                            spans DevSecOps, cloud infrastructure security, SIEM engineering,
                            endpoint protection, and incident response.
                        </p>
                        <p style="color:var(--text-secondary);line-height:1.8;margin-bottom:1rem;">
                            I build and maintain CI/CD pipelines with security checks baked into
                            every workflow, manage enterprise security tools including CrowdStrike,
                            Netskope, and Zscaler, and develop infrastructure as code using
                            Terraform and Ansible. My approach emphasizes automation, continuous
                            monitoring, and proactive threat detection.
                        </p>
                        <p style="color:var(--text-secondary);line-height:1.8;">
                            Before focusing on security, I honed my skills as a full-stack web
                            developer, which gives me a deep understanding of the systems I protect.
                            I hold a B.S. in Computer Science from Cal State Long Beach with a minor
                            in Cyber Security Applications.
                        </p>
                    </div>

                    <div class="reveal" style="margin-bottom: 3rem;">
                        <span class="section-label">Experience</span>
                        <h2 class="section-title" style="font-size:1.5rem;">
                            Work History
                        </h2>
                        <div class="timeline">
                            {jobs.map((j) => (
                                <div class="timeline-item" id={`job-${j.id}`}>
                                    <span class="timeline-item__date">{j.date}</span>
                                    <h3 class="timeline-item__role">{j.role}</h3>
                                    <p class="timeline-item__org">{j.org}</p>
                                    <div class="timeline-item__tech">
                                        {j.tech.map((t) => (
                                            <span>{t}</span>
                                        ))}
                                    </div>
                                    <ul class="timeline-item__details">
                                        {j.details.map((d) => (
                                            <li>{d}</li>
                                        ))}
                                    </ul>
                                </div>
                            ))}
                        </div>
                    </div>

                    <div class="reveal" style="margin-bottom: 3rem;">
                        <span class="section-label">Technical Skills</span>
                        <h2 class="section-title" style="font-size:1.5rem;">
                            Skill Graph
                        </h2>
                        <SkillGraph client:visible={{ rootMargin: '300px' }} />
                    </div>

                    <div class="reveal" style="margin-bottom: 3rem;">
                        <span class="section-label">Education</span>
                        <h2 class="section-title" style="font-size:1.5rem;">
                            Academic Background
                        </h2>
                        <div class="card">
                            <span class="card__tag">B.S. Computer Science</span>
                            <h3 class="card__title">California State University, Long Beach</h3>
                            <p class="card__desc" style="margin-bottom:0.5rem;">
                                <strong style="color:var(--white);">Aug 2019 – May 2023</strong>
                                <br />
                                Minor in Cyber Security Applications
                            </p>
                            <p class="card__desc" style="margin-bottom:0.75rem;">
                                <strong style="color:var(--text-primary);">
                                    Relevant Courses:
                                </strong>
                                Algorithms, Data Structures, Computer Security I &amp; II, Networks
                                and Network Security, Machine Learning, Cybersecurity in Business,
                                Artificial Intelligence, Digital Forensics, Object-Oriented
                                Programming, Software Engineering, Databases
                            </p>
                            <p class="card__desc" style="margin-bottom:0;">
                                <strong style="color:var(--text-primary);">Activities:</strong>
                                CSULB ACM (Webmaster —{' '}
                                <a
                                    href="https://acm.csulb.org"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    acm.csulb.org
                                </a>
                                ), CSULB Cybersecurity Club, CSULB Jiu Jitsu Club, CSULB Snow and
                                Ski Club, BeachHacks 2023
                            </p>
                        </div>
                        <div style="margin-top: 1.5rem;">
                            <a href="/projects" class="btn">
                                View My Projects →
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
