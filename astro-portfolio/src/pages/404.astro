---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title='404 — Page Not Found'
	description='404 — Page not found. Stephen Lyons Cybersecurity Portfolio.'
	fixedFooter={true}
	fullFooter={false}
	showScrollProgress={false}
>
	<main class='error-page' role='main'>
		<div>
			<div class='error-code glitch' aria-label='Error 404'>404</div>
			<p class='error-msg'>
				<span style='color:var(--accent);'>stephen@lyons:~$</span> cat requested_page<br
				/>
				<span style='color:var(--text-muted);'
					>cat: requested_page: No such file or directory</span
				>
			</p>
			<p
				style='color:var(--text-secondary);font-size:0.9rem;margin-bottom:2rem;max-width:400px;margin-inline:auto;'
			>
				The page you're looking for doesn't exist, has been moved, or
				was consumed by a rogue process.
			</p>
			<div
				style='display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;'
			>
				<a href='/' class='btn btn--filled'>← Back to Home</a>
				<button
					class='btn'
					data-open-terminal
					aria-label='Open terminal'
				>
					Open Terminal
				</button>
			</div>

			<pre
				style='color:var(--text-muted);font-size:0.55rem;margin-top:3rem;line-height:1.3;opacity:0.4;'
				aria-hidden='true'>
     _____
    |     |
    | 404 |
    |_____|
    |     |
    |  ?  |
    |_____|
   /|     |\
  / |     | \
 /__|_____|__\
      | |
      | |
     _| |_
    |_____|
      </pre>
		</div>
	</main>
</BaseLayout>
