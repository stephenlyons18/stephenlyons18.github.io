---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnsiTitle from '../components/AnsiTitle.astro';
import AnsiDivider from '../components/AnsiDivider.astro';
---

<BaseLayout
    title="404 — Page Not Found"
    description="404 — Page not found. Stephen Lyons Cybersecurity Portfolio."
    fullFooter={false}
    showScrollProgress={false}
>
    <main class="error-page" role="main">
        <div>
            <AnsiTitle
                text="404"
                label="404 — Page not found"
                as="h1"
                style="bubble"
                gap={2}
                maxFont={18}
                class="error-piece"
            />
            <p class="error-msg">
                <span style="color:var(--ui);">stephen@lyons:~$</span> cat requested_page
                <br />
                <span style="color:var(--text-muted);">
                    cat: requested_page: No such file or directory
                </span>
            </p>
            <p style="color:var(--text-secondary);font-size:0.9rem;margin-bottom:2rem;max-width:400px;margin-inline:auto;">
                The page you're looking for doesn't exist, has been moved, or was consumed by a
                rogue process.
            </p>
            <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
                <a href="/" class="btn btn--filled">
                    ← Back to Home
                </a>
                <button class="btn" data-open-terminal aria-label="Open terminal">
                    Open Terminal
                </button>
            </div>

            <AnsiDivider seed={8} />
        </div>
    </main>
</BaseLayout>
