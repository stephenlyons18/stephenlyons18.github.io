---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnsiTitle from '../components/AnsiTitle.astro';
import AnsiDivider from '../components/AnsiDivider.astro';
import AnsiDrips from '../components/AnsiDrips.astro';
import projects from '../data/projects';
import ProjectGallery from '../components/ProjectGallery.astro';
import Lightbox from '../components/Lightbox.astro';
import { responsiveImage } from '../lib/responsiveImages';

// Swap each project photo for build-time WebP variants (srcset).
const galleries = Object.fromEntries(
    await Promise.all(
        projects.map(async (p) => [
            p.id,
            await Promise.all(
                (p.images ?? []).map(async (img) => ({
                    ...img,
                    ...(await responsiveImage(img.src)),
                })),
            ),
        ]),
    ),
);
---

<BaseLayout
    title="Projects — Stephen Lyons"
    description="Projects by Stephen Lyons — Full-stack applications, security engineering, and DevSecOps automation."
>
    <section class="page-header" aria-label="Page header">
        <div class="container reveal">
            <span class="section-label">Portfolio</span>
            <AnsiTitle text="Projects" as="h1" style="wild" />
            <p class="page-desc">
                A selection of notable projects spanning full-stack development, mobile apps, and
                security engineering.
            </p>
            <AnsiDivider seed={3} />
        </div>
    </section>

    <section class="section" style="padding-top:0;" aria-label="Project showcase">
        <div class="container">
            {projects.map((p, i) => (
                <article
                    id={p.id}
                    class="card reveal"
                    style={i < projects.length - 1 ? 'margin-bottom: 2rem;' : undefined}
                >
                    <div style="display:flex;justify-content:space-between;align-items:start;flex-wrap:wrap;gap:1rem;margin-bottom:1rem;">
                        <div>
                            <span class="card__tag">{p.tag}</span>
                            <h2 class="card__title glitch" style="font-size:1.4rem;">
                                {p.title}
                            </h2>
                        </div>
                        {p.date && (
                            <span style="font-size:0.75rem;color:var(--text-muted);white-space:nowrap;">
                                {p.date}
                            </span>
                        )}
                    </div>

                    {p.descriptions.map((d) => (
                        <p class="card__desc" style="font-size:0.95rem;">
                            {d}
                        </p>
                    ))}

                    {p.sections?.map((s) => (
                        <>
                            <h3 style="font-family:var(--font-display);font-size:0.85rem;color:var(--ui);margin-bottom:0.75rem;text-transform:uppercase;letter-spacing:0.08em;">
                                {s.heading}
                            </h3>
                            <ul class="timeline-item__details" style="margin-bottom:1.25rem;">
                                {s.items.map((item) => (
                                    <li>{item}</li>
                                ))}
                            </ul>
                        </>
                    ))}

                    <div class="card__tech">
                        {p.tech.map((t) => (
                            <span>{t}</span>
                        ))}
                    </div>

                    {p.images && p.images.length > 0 && <ProjectGallery images={galleries[p.id]} />}

                    {p.links && p.links.length > 0 && (
                        <div style="margin-top:1.25rem;display:flex;gap:1rem;flex-wrap:wrap;">
                            {p.links.map((link) => (
                                <a
                                    href={link.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="btn"
                                    style="font-size:0.8rem;padding:0.5rem 1rem;"
                                >
                                    {link.label}
                                </a>
                            ))}
                        </div>
                    )}
                    <AnsiDrips
                        cols={280}
                        seed={i + 31}
                        maxStem={0}
                        density={0.08}
                        class="card-drips"
                    />
                </article>
            ))}
        </div>
    </section>
    <Lightbox />
</BaseLayout>
