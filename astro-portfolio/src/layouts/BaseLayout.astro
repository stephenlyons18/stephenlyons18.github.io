---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnsiWall from '../components/AnsiWall.astro';

interface Props {
    title: string;
    description: string;
    fixedFooter?: boolean;
    fullFooter?: boolean;
    showHeader?: boolean;
    /** Set to false on pages with no scrollable content (e.g. 404) to avoid
     *  loading the React + Motion bundle unnecessarily. Defaults to true. */
    showScrollProgress?: boolean;
}

const {
    title,
    description,
    fixedFooter = false,
    fullFooter = true,
    showHeader = true,
    showScrollProgress = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="author" content="Stephen Lyons" />
        <meta name="theme-color" content="#0c0a12" />
        {[
            'press-start-2p-subset.woff2',
            'departure-mono-subset.woff2',
            'jetbrains-mono-art.woff2',
        ].map((f) => (
            <link rel="preload" href={`/fonts/${f}`} as="font" type="font/woff2" crossorigin />
        ))}
        <!-- Before first paint (no flash): the saved theme, and the accessibility menu's choices
             (Header.astro / site.ts). Old values from the green-era themes fall back to default.
             Reduced motion is on when the OS asks for it, or when the user turned it on here. -->
        <script is:inline>
            try {
                var d = document.documentElement;
                var t = localStorage.getItem('sl-theme');
                if (t && /^(bubble|ansi|sunset|green)$/.test(t)) d.setAttribute('data-theme', t);
                var a = JSON.parse(localStorage.getItem('sl-a11y') || '{}');
                for (var k in a)
                    if (a[k] && /^[a-z-]+$/.test(k)) d.setAttribute('data-a11y-' + k, '');
                if (a.motion || matchMedia('(prefers-reduced-motion: reduce)').matches)
                    d.setAttribute('data-reduce-motion', '');
            } catch (e) {}
        </script>
        <title>{title}</title>
        <link
            rel="icon"
            href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛡️</text></svg>"
        />
    </head>
    <body>
        {showScrollProgress && <div class="scroll-progress-bar" aria-hidden="true"></div>}
        <AnsiWall />

        {showHeader && <Header />}

        <slot />

        <Footer fixed={fixedFooter} full={fullFooter} />

        <!-- terminal.js is loaded by site.js on idle (or on first Ctrl+K / terminal button). -->
        <script is:inline src="/scripts/site.js" defer></script>
    </body>
</html>
