---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnsiWall from '../components/AnsiWall.astro';
import ScrollProgress from '../components/react/ScrollProgress';

interface Props {
    title: string;
    description: string;
    fixedFooter?: boolean;
    fullFooter?: boolean;
    showHeader?: boolean;
    /** Set to false on pages with no scrollable content (e.g. 404) to avoid
     *  loading the React + Motion bundle unnecessarily. Defaults to true. */
    showScrollProgress?: boolean;
}

const {
    title,
    description,
    fixedFooter = false,
    fullFooter = true,
    showHeader = true,
    showScrollProgress = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="author" content="Stephen Lyons" />
        <meta name="theme-color" content="#0c0a12" />
        <link
            rel="preload"
            href="/fonts/jetbrains-mono-subset.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <!-- Apply the saved theme before first paint (no flash). Old values from the green-era
             themes (cyan/amber) fall back to the default. -->
        <script is:inline>
            try {
                var t = localStorage.getItem('sl-theme');
                if (t && /^(bubble|ansi|sunset|green)$/.test(t))
                    document.documentElement.setAttribute('data-theme', t);
            } catch (e) {}
        </script>
        <title>{title}</title>
        <link
            rel="icon"
            href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛡️</text></svg>"
        />
    </head>
    <body>
        {showScrollProgress && <ScrollProgress client:load />}
        <AnsiWall />

        {showHeader && <Header />}

        <slot />

        <Footer fixed={fixedFooter} full={fullFooter} />

        <script is:inline src="/scripts/terminal.js" defer></script>
        <script is:inline src="/scripts/site.js" defer></script>
    </body>
</html>
