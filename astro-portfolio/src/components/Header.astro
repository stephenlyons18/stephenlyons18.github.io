---
import { ROUTES } from '../data/site';
import { THEMES, TITLE_STYLES } from '../data/themes';
import { pieceToSvg, renderPiece } from '../lib/ansi/piece';

// Routes are directory URLs ("/about/"); compare without the trailing slash.
const trim = (p: string) => p.replace(/(index)?\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => trim(Astro.url.pathname) === trim(href);

// The menu's preview: a tiny "SL" in each style, coloured by the same tokens as the titles, so it
// shows exactly what the headings will look like (CSS picks the style; a hovered theme recolours it).
const mini = (style: 'bubble' | 'wild') =>
    pieceToSvg(
        renderPiece('SL', {
            style,
            seed: 2,
            sparkles: 0,
            overspray: 0,
            cloud: 0,
            arrow: false,
            blades: 0,
            drips: 0.2,
        }),
        { attrs: { class: 'a11y-preview__piece', 'aria-hidden': 'true', focusable: 'false' } },
    );
---

<header class="site-header" role="banner">
    <div class="container">
        <a href="/" class="logo" aria-label="Stephen Lyons — Home">
            <span class="logo-bracket">[</span>SL<span class="logo-bracket">]</span>
        </a>
        <nav class="nav-links" role="navigation" aria-label="Main navigation">
            {ROUTES.map((r) => (
                <a href={r.path} class:list={[isActive(r.path) && 'active']}>
                    {r.name}
                </a>
            ))}
        </nav>
        <div class="header-actions">
            <button
                class="nav-icon-btn a11y-btn"
                popovertarget="a11y-menu"
                aria-label="Accessibility options"
                title="Accessibility options"
            >
                <svg
                    class="pixel-icon"
                    viewBox="0 0 8 8"
                    width="16"
                    height="16"
                    aria-hidden="true"
                    shape-rendering="crispEdges"
                >
                    <path
                        fill="currentColor"
                        d="M3 0h2v2H3zM0 2h8v1H0zM3 3h2v2H3zM2 5h1v3H2zM5 5h1v3H5zM3 5h2v1H3z"
                    ></path>
                </svg>
                <span class="nav-icon-btn__label">Accessibility</span>
            </button>
            <button class="nav-terminal-btn" aria-label="Open terminal" data-open-terminal>
                <span class="nav-terminal-btn__icon" aria-hidden="true">
                    &gt;_
                </span>
                <span class="nav-terminal-btn__label">Terminal</span>
            </button>
        </div>
        <button class="nav-toggle" aria-label="Toggle mobile navigation" aria-expanded="false">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>
</header>

<!-- Accessibility menu: a native popover (top layer, light dismiss, Escape) opened from the header.
     Each switch sets a data-a11y-* attribute on <html>; global.css does the rest. site.ts wires it
     up and saves to localStorage; BaseLayout's head script re-applies it before first paint. -->
<div id="a11y-menu" class="a11y-menu" popover role="dialog" aria-labelledby="a11y-menu-title">
    <p class="a11y-menu__title" id="a11y-menu-title">
        Accessibility
    </p>
    <!-- Headings (R30): letter style and colour theme. Both apply at once (data-title-style and
         data-theme on <html>), are saved, and match the terminal's `style` and `theme`. -->
    <div class="a11y-preview" data-a11y-preview aria-hidden="true">
        <span class="a11y-preview__swatch"></span>
        <span class="a11y-preview__art" set:html={mini('bubble') + mini('wild')} />
        <span class="a11y-preview__name" data-a11y-preview-name></span>
    </div>
    <fieldset class="a11y-group">
        <legend class="a11y-group__label">Heading style</legend>
        <div class="a11y-seg">
            {TITLE_STYLES.map((t) => (
                <label class="a11y-seg__opt">
                    <input type="radio" name="a11y-title-style" value={t.id} data-title-style-opt />
                    <span>{t.label}</span>
                </label>
            ))}
        </div>
    </fieldset>
    <fieldset class="a11y-group">
        <legend class="a11y-group__label">Colours</legend>
        <div class="a11y-themes">
            {THEMES.map((t) => (
                <label class="a11y-theme" title={t.desc}>
                    <input type="radio" name="a11y-theme" value={t.id} data-theme-opt />
                    <span class="a11y-theme__swatch" data-theme={t.id} aria-hidden="true" />
                    <span class="a11y-theme__label">{t.label}</span>
                </label>
            ))}
        </div>
    </fieldset>
    <ul class="a11y-menu__list">
        {[
            ['plain', 'Plain headings', 'Swap graffiti titles for plain text'],
            ['motion', 'Reduce motion', 'Stop animations and transitions'],
            ['font', 'Readable font', 'Plain sans-serif instead of pixel type'],
            ['large', 'Larger text', 'Scale all text up by 25%'],
            ['contrast', 'High contrast', 'Brighter text and borders'],
            ['wall', 'Hide wall texture', 'Plain background behind content'],
        ].map(([key, label, hint]) => (
            <li>
                <label class="a11y-switch">
                    <input type="checkbox" role="switch" data-a11y={key} />
                    <span class="a11y-switch__text">
                        <span class="a11y-switch__label">{label}</span>
                        <span class="a11y-switch__hint" data-hint={key}>
                            {hint}
                        </span>
                    </span>
                    <span class="a11y-switch__track" aria-hidden="true" />
                </label>
            </li>
        ))}
    </ul>
    <div class="a11y-menu__foot">
        <button type="button" class="a11y-menu__reset" data-a11y-reset>
            Reset
        </button>
        <button
            type="button"
            class="a11y-menu__close"
            popovertarget="a11y-menu"
            popovertargetaction="hide"
        >
            Done
        </button>
    </div>
</div>
