---
/**
 * Paint drips (src/lib/ansi/wall.ts renderDripStrip): under a sprayed bar (`bar`, the section
 * divider) or hanging off a card's bottom edge. Static, aria-hidden text, animated by CSS: the
 * drips are dealt into a few runs that each slide out as one layer (see global.css .drip-run).
 */
import { renderDripStrip } from '../lib/ansi/wall';
import { dripsToHtml } from '../lib/ansi/html';

interface Props {
    cols: number;
    seed?: number;
    bar?: boolean;
    maxStem?: number;
    minStem?: number;
    density?: number;
    class?: string;
}
const {
    cols,
    seed = 1,
    bar = false,
    maxStem = 2,
    minStem = 0,
    density,
    class: className,
} = Astro.props;
const strip = renderDripStrip(cols, seed, { maxStem, minStem, ...(density ? { density } : {}) });
---

<div
    class:list={['drips', bar && 'drips--bar', className]}
    data-drips
    aria-hidden="true"
    style={`--rows:${strip.rows}`}
>
    <pre class="ansi" style={`--cols:${cols}`} set:html={dripsToHtml(strip, bar)} />
</div>
