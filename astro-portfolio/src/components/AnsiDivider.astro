---
/** A sprayed bar with paint drips — section separator. Decorative (aria-hidden), zero JS. */
import { renderDivider } from '../lib/ansi/wall';
import { artToHtml } from '../lib/ansi/html';

interface Props {
    seed?: number;
    class?: string;
}
const { seed = 1, class: className } = Astro.props;
// 200 cells at ≤ 9px cells ≈ 1080px: spans a desktop container; scales down to any width.
const art = renderDivider(200, seed);
---

<div class:list={['ansi-divider', className]} aria-hidden="true">
    <pre class="ansi" style={`--cols:${art.cols}`} set:html={artToHtml(art)} />
</div>
