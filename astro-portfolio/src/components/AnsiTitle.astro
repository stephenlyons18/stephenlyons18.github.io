---
/**
 * ANSI graffiti title (src/lib/ansi/piece.ts), drawn at build time as an inline SVG of half-block
 * cells: zero runtime JS.
 *
 * The art is aria-hidden; a real heading carries the text for screen readers, search, copy/paste and
 * the a11y menu's Plain headings. The art scales to its container. For multi-word text, stacked
 * variants (2 lines, or up to `lines`) take over by container query whenever the one-line piece
 * would drop below a legible cell size.
 */
import {
    balanceLines,
    pieceToSvg,
    renderPiece,
    type Piece,
    type PieceOptions,
    type PieceStyle,
} from '../lib/ansi/piece';

interface Props {
    text: string;
    /** Accessible heading text, if it should say more than the art (defaults to `text`). */
    label?: string;
    /** Pure decoration (e.g. the avatar monogram): render no heading at all. */
    decorative?: boolean;
    /** Element for the accessible text: a heading level, or `p` for a tagline. */
    as?: 'h1' | 'h2' | 'h3' | 'p';
    style?: PieceStyle;
    seed?: number;
    /** Largest cell size (px): one unit is 0.6 × this wide. */
    maxFont?: number;
    /** Below this cell size a stacked variant takes over (multi-word text only). */
    minFont?: number;
    /** Most lines a stacked variant may use (2 or 3). */
    lines?: number;
    /** Any other piece options (blades, arrow, drips…). */
    opts?: PieceOptions;
    class?: string;
}

const {
    text,
    label,
    decorative = false,
    as: Tag = 'h2',
    style = 'wild',
    seed = 0,
    maxFont = 13,
    minFont = 6,
    lines = 2,
    opts = {},
    class: className,
} = Astro.props;

const svg = (p: Piece, cls: string, width?: string) =>
    pieceToSvg(p, {
        attrs: {
            class: `ansi-svg ${cls}`.trim(),
            'aria-hidden': 'true',
            focusable: 'false',
            style: `--w:${p.w}${width ? `;width:${width}` : ''}`,
        },
    });

const one = renderPiece(text, { style, seed, ...opts });
// Stacked variants, 2…lines lines; each line is its own piece, sized relative to the widest.
const stacks = Array.from({ length: Math.max(0, lines - 1) }, (_, i) => balanceLines(text, i + 2))
    .filter(
        (parts, i, all) => parts.length === i + 2 && (i === 0 || all[i - 1]!.length < parts.length),
    )
    .map((parts) => {
        // Only the last line keeps the arrow: it points on, out of the whole title.
        const pieces = parts.map((t, i) =>
            renderPiece(t, {
                style,
                seed: seed + i + 1,
                ...opts,
                ...(i < parts.length - 1 ? { arrow: false } : {}),
            }),
        );
        return { pieces, w: Math.max(...pieces.map((p) => p.w)) };
    });
const id = `ansi-${Math.abs([...text].reduce((h, c) => (h * 31 + c.charCodeAt(0)) | 0, seed))}`;
// Container widths (px) below which each variant would render cells smaller than minFont.
const variants = [{ w: one.w }, ...stacks];
const breaks = variants.map((v) => Math.ceil(v.w * 0.6 * minFont));
const queries = stacks
    .map((_, i) => {
        const hide = i === 0 ? '.ansi-title__one' : `.ansi-title__stack--${i + 1}`;
        return `@container (max-width: ${breaks[i]}px) { #${id} ${hide} { display: none } #${id} .ansi-title__stack--${i + 2} { display: block } }`;
    })
    .join(' ');
---

<div
    class:list={['ansi-title', decorative && 'ansi-title--deco', className]}
    id={id}
    style={`--ansi-max:${maxFont}px`}
>
    {
        /* Screen-reader text; the a11y menu's "plain headings" makes it the visible title. */
        !decorative && <Tag class="sr-only ansi-title__text">{label ?? text}</Tag>
    }
    <Fragment set:html={svg(one, 'ansi-title__one')} />
    {stacks.map((s, i) => (
        <div class={`ansi-title__stack ansi-title__stack--${i + 2}`} aria-hidden="true">
            {s.pieces.map((p) => (
                <Fragment
                    set:html={svg(
                        p,
                        '',
                        `min(${((100 * p.w) / s.w).toFixed(2)}%, calc(${p.w} * var(--ansi-max) * 0.6))`,
                    )}
                />
            ))}
        </div>
    ))}
    {queries && <style set:html={queries} />}
</div>
