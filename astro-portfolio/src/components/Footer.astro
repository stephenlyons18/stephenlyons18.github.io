---
interface Props {
	fixed?: boolean;
	full?: boolean;
}
const {fixed = false, full = true} = Astro.props;
---

<footer
	class='site-footer'
	role='contentinfo'
	style={fixed ? "position:fixed;bottom:0;left:0;right:0;" : undefined}
>
	<div class='container'>
		{
			full && (
				<nav class='footer-nav' aria-label='Footer navigation'>
					<a href='/'>Home</a>
					<a href='/about'>About</a>
					<a href='/projects'>Projects</a>
					<a href='/contact'>Contact</a>
				</nav>
			)
		}
		<p>
			&copy; 2026 Stephen Lyons.
			{full && <>Built with Astro, Tailwind CSS, and Motion. </>}
			<span style='color:var(--accent);'
				>Press <kbd>Ctrl+K</kbd> for terminal.</span
			>
		</p>
	</div>
</footer>
