---
/**
 * An original piece painted on the brick wall, in the page's whitespace (R27): leet words in
 * bubble or wildstyle (src/lib/ansi/piece.ts), drawn at build time as an inline SVG.
 *
 * Pure decoration: aria-hidden, never interactive, and behind all content (z-index -1, above the
 * wall). It never sits behind copy: every spot is empty space (a gap between sections, the side of
 * a hero or header, a wide screen's gutter). site.ts sprays each piece on once, when it is first
 * rendered or scrolled into view; under reduced motion it is simply there.
 */
import { pieceToSvg, renderPiece, type PieceStyle } from '../lib/ansi/piece';

type Spot =
    | 'gap-left' // straddling the boundary into this section, at the container's left edge
    | 'gap-right'
    | 'side-left' // beside the section's content, vertically centred (wide layouts only)
    | 'side-right'
    | 'gutter-left' // in the margin outside the container (very wide screens only)
    | 'gutter-right';

interface Props {
    text: string;
    spot: Spot;
    style?: PieceStyle;
    seed?: number;
    /** Piece height (CSS length); its width follows from the art. */
    h?: string;
    /** Height on phones, for gap spots (the others don't show there). */
    hMobile?: string;
    /** Slight tilt, like a piece painted by hand (degrees). */
    tilt?: number;
    /** Vertical position for side and gutter spots (CSS length or %). */
    top?: string;
    /** Gap spots: sit inside this section's top padding instead of straddling the boundary (when
     *  the section above ends flush with content, like the hero). */
    inside?: boolean;
}

const {
    text,
    spot,
    style = 'bubble',
    seed = 0,
    h = '6rem',
    hMobile = '3.75rem',
    tilt = 0,
    top = '50%',
    inside = false,
} = Astro.props;
// Quieter than titles: no overspray (mist adds bytes, not much look at this size), one sparkle.
const piece = renderPiece(text, {
    style,
    seed,
    overspray: 0,
    sparkles: 1,
    dripMax: 7,
    slashedZero: true,
    cloud: 0,
});
const svg = pieceToSvg(piece, { attrs: { focusable: 'false' } });
---

<div
    class:list={['wall-piece', `wall-piece--${spot}`, inside && 'wall-piece--inside']}
    aria-hidden="true"
    data-wall-piece
    style={`--h:${h};--h-m:${hMobile};--tilt:${tilt}deg;--top:${top};--ratio:${+(piece.w * (piece.aspect ?? 1)).toFixed(2)}/${piece.h}`}
    set:html={svg}
/>
