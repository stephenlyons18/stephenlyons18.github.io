{
  "name": "astro-portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm build:scripts && astro dev",
    "build:scripts": "esbuild src/scripts/site.ts src/scripts/terminal.ts --bundle --format=iife --target=es2020 --minify --outdir=public/scripts --log-level=warning",
    "build": "pnpm build:scripts && astro build && node scripts/postbuild.mjs",
    "build:local": "pnpm test && pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "preview": "astro preview",
    "format": "prettier --write \"src/**/*.{astro,ts,tsx,js,mjs,css}\" \"scripts/**/*.mjs\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,tsx,js,mjs,css}\" \"scripts/**/*.mjs\" \"e2e/**/*.ts\"",
    "astro": "astro",
    "shots": "SHOTS=1 playwright test shots --project desktop --project laptop --project tablet --project mobile"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "astro": "^7.3.8",
    "d3-force": "^3.0.0",
    "motion": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@10.34.7"
}
