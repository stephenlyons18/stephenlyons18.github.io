{
  "name": "astro-portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build:scripts && astro dev",
    "build:scripts": "esbuild src/scripts/site.ts src/scripts/terminal.ts --bundle --format=iife --target=es2020 --minify --outdir=public/scripts --log-level=warning",
    "build": "npm run build:scripts && astro build && node scripts/postbuild.mjs",
    "build:local": "npm run test && npm run build",
    "test": "jest --config jest.config.cjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "astro": "^7.3.1",
    "d3-force": "^3.0.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "^7.0.2"
  }
}
